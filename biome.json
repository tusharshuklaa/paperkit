{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": [
      "**/dist/**",
      "**/.next/**",
      "**/node_modules/**",
      "**/*.tsbuildinfo",
      "**/next-env.d.ts",
      "reference/**",
      "graphify-out/**",
      ".agents/**",
      ".claude/**",
      ".codex/**",
      ".github/**",
      ".vscode/**",
      ".mcp.json",
      ".taste-skill/**",
      "test-results/**",
      "playwright-report/**",
      "bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "include": ["apps/web/components/SiteFooter.tsx", "apps/web/components/Header.tsx"],
      "linter": { "rules": { "a11y": { "useValidAnchor": "off" } } }
    },
    { "include": ["**/*.css"], "linter": { "enabled": false }, "formatter": { "enabled": false } }
  ]
}
