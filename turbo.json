{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "fmt": { "cache": false, "outputs": [] },
    "typecheck": { "dependsOn": ["^build", "^typecheck"] },
    "build": {
      "env": ["PAPERKIT_CANONICAL_ORIGIN"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "cache": false,
      "dependsOn": ["^lint"]
    }
  }
}
